@model IEnumerable<Actividad_Autonoma_SQA_1.Models.PokemonSummary>

@{
    ViewData["Title"] = "Pokédex Gaming Hub";
}

<style>
    .pokemon-card {
        background: linear-gradient(145deg, #131c31, #0f172a);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .pokemon-card:hover {
            transform: translateY(-8px);
            border-color: rgba(239, 68, 68, 0.5);
            box-shadow: 0 12px 30px -10px rgba(239, 68, 68, 0.3);
        }

    .img-container {
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.2) 100%);
        border-radius: 50%;
    }

    .btn-gamer {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .btn-gamer:hover {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.6);
            color: white;
        }

    .page-link-gamer {
        background-color: #1e293b !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        color: #e2e8f0 !important;
    }

        .page-link-gamer:hover {
            background-color: #ef4444 !important;
            border-color: #ef4444 !important;
            color: white !important;
        }
</style>

<div class="container my-4">
    <div class="text-center mb-5">
        <h1 class="text-danger fw-bold display-4 gaming-font">⚡ ¡APRENDE MÁS SOBRE LOS POKEMONS! ⚡</h1>
        <p class="text-secondary">Selecciona un registro para analizar estadísticas y atributos de cada uno</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var poke in Model)
        {
            <div class="col">
                <div class="card h-100 pokemon-card rounded-4 p-3 text-center position-relative overflow-hidden">
                    <span class="badge bg-dark text-danger border border-danger border-opacity-25 position-absolute top-0 start-0 m-3 rounded-pill font-monospace">#@poke.Id</span>

                    <div class="img-container mx-auto p-3 mt-3 d-flex align-items-center justify-content-center" style="width: 140px; height: 140px;">
                        <img src="@poke.ImageUrl" class="img-fluid" alt="@poke.Name" style="max-height: 120px; object-fit: contain; filter: drop-shadow(0 8px 8px rgba(0,0,0,0.5));">
                    </div>

                    <div class="card-body d-flex flex-column px-2 pb-2">
                        <h4 class="card-title text-capitalize text-light fw-bold mb-3">@poke.Name</h4>
                        <a asp-action="Details" asp-route-id="@poke.Id" class="btn btn-gamer rounded-pill mt-auto py-2 fw-semibold shadow-sm">VER ATRIBUTOS</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="my-5" aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link page-link-gamer rounded-start-pill px-4" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">&larr; Anterior</a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link page-link-gamer border-0 px-4 text-secondary">Página @ViewBag.CurrentPage / @ViewBag.TotalPages</span>
            </li>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link page-link-gamer rounded-end-pill px-4" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Siguiente &rarr;</a>
                </li>
            }
        </ul>
    </nav>
</div>